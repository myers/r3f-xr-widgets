{
  "name": "r3f-xr-widgets",
  "version": "0.3.0",
  "description": "Reusable XR/VR widgets and utilities for React Three Fiber - includes resizable windows, 360° video player, splash screens, and XR helper components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "pages:build": "bash scripts/build-all-demos.sh",
    "pages:preview": "mkdir -p _pages_serve/r3f-xr-widgets && cp -r _pages/* _pages_serve/r3f-xr-widgets/ && npx serve _pages_serve -p 5173",
    "pages:dev": "bash scripts/build-all-demos.sh && mkdir -p _pages_serve/r3f-xr-widgets && cp -r _pages/* _pages_serve/r3f-xr-widgets/ && npx serve _pages_serve -p 5173",
    "docs:generate": "typedoc",
    "docs:dev": "pnpm docs:generate && vitepress dev docs",
    "docs:build": "pnpm docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "typecheck:demos": "pnpm -r --filter './demos/*' exec tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "pnpm build && git push && git push --tags",
    "publish:npm": "pnpm publish",
    "publish:check": "npm pack --dry-run",
    "test": "vitest ${TEST_FILTER:-}",
    "test:node": "vitest --project=unit ${TEST_FILTER:-}",
    "test:browser": "vitest --project=browser ${TEST_FILTER:-}",
    "test:headed": "vitest --browser.headless=false",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "react",
    "three",
    "react-three-fiber",
    "xr",
    "vr",
    "ar",
    "webxr",
    "widgets",
    "components",
    "splash-screen",
    "resizable",
    "eye-level",
    "utilities",
    "video-player",
    "360-video",
    "equirectangular",
    "vr-video"
  ],
  "author": "Myers Carpenter <myers@maski.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/myers/r3f-xr-widgets.git"
  },
  "homepage": "https://icepick.info/r3f-xr-widgets/",
  "bugs": {
    "url": "https://github.com/myers/r3f-xr-widgets/issues"
  },
  "peerDependencies": {
    "@pmndrs/pointer-events": ">=6.0.0",
    "@preact/signals-core": ">=1.0.0",
    "@react-spring/three": ">=10.0.0",
    "@react-three/drei": ">=9.0.0",
    "@react-three/fiber": ">=8.0.0",
    "@react-three/handle": ">=6.0.0",
    "@react-three/uikit": ">=1.0.0",
    "@react-three/uikit-default": ">=1.0.0",
    "@react-three/uikit-horizon": ">=1.0.0",
    "@react-three/uikit-lucide": ">=1.0.0",
    "@react-three/xr": ">=5.0.0",
    "react": ">=18",
    "three": "0.165.0"
  },
  "devDependencies": {
    "@pmndrs/pointer-events": "^6.6.27",
    "@preact/signals-core": "^1.9.0",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/handle": "^6.6.27",
    "@react-three/test-renderer": "^9.1.0",
    "@react-three/uikit": "~1.0.0",
    "@react-three/uikit-default": "~1.0.0",
    "@react-three/uikit-horizon": "~1.0.0",
    "@react-three/uikit-lucide": "~1.0.0",
    "@react-three/xr": "^6.6.27",
    "@testing-library/react": "^16.3.0",
    "@types/debug": "^4.1.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.165.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^4.0.10",
    "@vitest/browser-playwright": "^4.0.10",
    "@vitest/browser-preview": "^4.0.10",
    "@webxr-input-profiles/assets": "^1.0.20",
    "iwer": "^2.1.1",
    "jsdom": "^27.2.0",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.165.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.10",
    "vitest-browser-react": "^2.0.2",
    "vitest-mock-extended": "^3.1.0"
  },
  "packageManager": "pnpm@10.12.1",
  "patchedDependencies": {
    "iwer@2.1.1": "patches/iwer@2.1.1.patch",
    "@pmndrs/xr@6.6.28": "patches/@pmndrs__xr@6.6.28.patch",
    "@react-three/uikit@1.0.60": "patches/@react-three__uikit@1.0.60.patch",
    "@iwer/devui@1.1.2": "patches/@iwer__devui@1.1.2.patch"
  },
  "dependencies": {
    "@pmndrs/msdfonts": "^1.0.59",
    "debug": "^4.4.3"
  }
}

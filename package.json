{
  "name": "r3f-xr-widgets",
  "version": "0.2.4",
  "description": "Reusable XR/VR widgets and utilities for React Three Fiber - includes resizable windows, 360° video player, splash screens, and XR helper components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "demo": "cd demos/resizable-window && vite --host",
    "demo:resizable-window": "cd demos/resizable-window && vite --host",
    "demo:video-player": "cd demos/video-player && vite --host",
    "demo:control-panel-test": "cd demos/control-panel-test && vite --host",
    "demo:control-panel-test:prod": "cd demos/control-panel-test && vite --host --mode production",
    "demo:landing": "npx vite demos --host --port 5173",
    "demo:build": "cd demos/resizable-window && vite build",
    "pages:build": "bash scripts/build-all-demos.sh",
    "pages:preview": "mkdir -p _pages_serve/r3f-xr-widgets && cp -r _pages/* _pages_serve/r3f-xr-widgets/ && npx serve _pages_serve --port 5173",
    "pages:dev": "bash scripts/build-all-demos.sh && mkdir -p _pages_serve/r3f-xr-widgets && cp -r _pages/* _pages_serve/r3f-xr-widgets/ && npx serve _pages_serve --port 5173",
    "quest-open": "node scripts/quest-open.js",
    "quest:resizable-window": "node scripts/start-dev-server.js resizable-window",
    "quest:horizon-window": "node scripts/start-dev-server.js horizon-window",
    "quest:video-player": "node scripts/start-dev-server.js video-player",
    "quest:3d-video": "node scripts/start-dev-server.js 3d-video",
    "quest:control-panel-test": "node scripts/start-dev-server.js control-panel-test",
    "docs:generate": "typedoc",
    "docs:dev": "pnpm docs:generate && vitepress dev docs",
    "docs:build": "pnpm docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release": "pnpm build && git push && git push --tags",
    "publish:npm": "pnpm publish",
    "publish:check": "npm pack --dry-run",
    "test": "vitest ${TEST_FILTER:-}",
    "test:headed": "vitest --browser.headless=false",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "react",
    "three",
    "react-three-fiber",
    "xr",
    "vr",
    "ar",
    "webxr",
    "widgets",
    "components",
    "splash-screen",
    "resizable",
    "eye-level",
    "utilities",
    "video-player",
    "360-video",
    "equirectangular",
    "vr-video"
  ],
  "author": "Myers Carpenter <myers@maski.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/myers/r3f-xr-widgets.git"
  },
  "homepage": "https://icepick.info/r3f-xr-widgets/",
  "bugs": {
    "url": "https://github.com/myers/r3f-xr-widgets/issues"
  },
  "peerDependencies": {
    "@pmndrs/pointer-events": ">=6.0.0",
    "@preact/signals-core": ">=1.0.0",
    "@react-spring/three": ">=10.0.0",
    "@react-three/drei": ">=9.0.0",
    "@react-three/fiber": ">=8.0.0",
    "@react-three/handle": ">=6.0.0",
    "@react-three/uikit": ">=1.0.0",
    "@react-three/uikit-default": ">=1.0.0",
    "@react-three/uikit-horizon": ">=1.0.0",
    "@react-three/uikit-lucide": ">=1.0.0",
    "@react-three/xr": ">=5.0.0",
    "react": ">=18",
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@pmndrs/pointer-events": "^6.6.27",
    "@preact/signals-core": "^1.9.0",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@react-three/handle": "^6.6.27",
    "@react-three/uikit": "~1.0.0",
    "@react-three/uikit-default": "~1.0.0",
    "@react-three/uikit-horizon": "~1.0.0",
    "@react-three/uikit-lucide": "~1.0.0",
    "@react-three/xr": "^6.6.27",
    "@storybook/addon-docs": "^10.0.7",
    "@storybook/react-vite": "^10.0.7",
    "@storybook/test-runner": "^0.24.1",
    "@types/debug": "^4.1.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.165.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^4.0.10",
    "@vitest/browser-playwright": "^4.0.10",
    "@vitest/browser-preview": "^4.0.10",
    "@webxr-input-profiles/assets": "^1.0.20",
    "chrome-remote-interface": "^0.33.2",
    "detect-port": "^1.6.1",
    "iwer": "^2.1.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.56.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^10.0.7",
    "three": "^0.165.0",
    "typedoc": "^0.28.14",
    "typedoc-plugin-markdown": "^4.9.0",
    "typedoc-vitepress-theme": "^1.1.2",
    "typescript": "^5.7.2",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.10",
    "vitest-browser-react": "^2.0.2",
    "which": "^5.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "patchedDependencies": {
    "iwer@2.1.1": "patches/iwer@2.1.1.patch",
    "@pmndrs/xr@6.6.27": "patches/@pmndrs__xr@6.6.27.patch",
    "@pmndrs/uikit@1.0.59": "patches/@pmndrs__uikit@1.0.59.patch"
  },
  "dependencies": {
    "debug": "^4.4.3"
  }
}

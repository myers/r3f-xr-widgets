@@ -0,0 +1,111 @@
+import { ShaderMaterial, Vector3 } from 'three'
+
+// Arc shader - vertex shader (same as proximity shader)
+export const arcVertexShader = /* glsl */ `
+varying vec3 vWorldPosition;
+varying vec2 vUv;
+
+void main() {
+  vUv = uv;
+  vec4 worldPosition = modelMatrix * vec4(position, 1.0);
+  vWorldPosition = worldPosition.xyz;
+  gl_Position = projectionMatrix * viewMatrix * worldPosition;
+}
+`
+
+// Arc shader - fragment shader
+export const arcFragmentShader = /* glsl */ `
+uniform vec3 uPointerPosition;
+uniform float uRadius;
+uniform vec3 uLineColor;
+uniform float uInnerRadius;
+uniform float uOuterRadius;
+uniform float uCornerGap;
+
+varying vec3 vWorldPosition;
+varying vec2 vUv;
+
+void main() {
+  // Calculate proximity fade with steeper falloff
+  float dist = distance(vWorldPosition, uPointerPosition);
+  float fadeFactor = smoothstep(uRadius, 0.0, dist);
+  fadeFactor = fadeFactor * fadeFactor; // Square for steeper falloff
+
+  // Calculate position relative to corner
+  // The quad is centered at the content corner (mesh center = UV 0.5, 0.5)
+  // Arc always extends into top-right quadrant, rotation handles other corners
+  vec2 cornerUV = vUv - vec2(0.5, 0.5);
+
+  // Distance from corner in UV space
+  float uvDist = length(cornerUV);
+
+  // Calculate distance from corner in world space
+  // Quad is 0.12m, so uvDist * 0.12 gives world distance
+  float worldDist = uvDist * 0.12;
+
+  // Check if in top-right quadrant only
+  bool inQuadrant = cornerUV.x >= 0.0 && cornerUV.y >= 0.0;
+
+  // Calculate angle from corner (0° = right, 90° = up)
+  float angle = atan(cornerUV.y, cornerUV.x);
+  // Angle ranges from 0 to π/2 (0 to 90 degrees) in top-right quadrant
+
+  // Define arc endpoints at specific angles (full 90 degree arc)
+  float arcStartAngle = radians(0.0);
+  float arcEndAngle = radians(90.0);
+
+  // Line thickness parameters
+  float lineCenter = (uInnerRadius + uOuterRadius) * 0.5;
+  float lineHalfWidth = (uOuterRadius - uInnerRadius) * 0.5;
+  float distFromLineCenter = abs(worldDist - lineCenter);
+
+  // Calculate if we're in the main arc body (between start and end angles)
+  bool inArcBody = angle >= arcStartAngle && angle <= arcEndAngle;
+
+  // Standard line alpha for the arc body
+  float lineAlpha = smoothstep(lineHalfWidth + 0.005, lineHalfWidth - 0.005, distFromLineCenter);
+
+  // Calculate rounded caps at endpoints
+  // Cap at start angle (30°)
+  vec2 capStart = vec2(cos(arcStartAngle), sin(arcStartAngle)) * lineCenter;
+  float distToCapStart = length(cornerUV * 0.12 - capStart);
+  float capStartAlpha = smoothstep(lineHalfWidth + 0.005, lineHalfWidth - 0.005, distToCapStart);
+
+  // Cap at end angle (60°)
+  vec2 capEnd = vec2(cos(arcEndAngle), sin(arcEndAngle)) * lineCenter;
+  float distToCapEnd = length(cornerUV * 0.12 - capEnd);
+  float capEndAlpha = smoothstep(lineHalfWidth + 0.005, lineHalfWidth - 0.005, distToCapEnd);
+
+  // Combine arc body with both caps (use max to show all parts)
+  // Limit arc body to the angle range, but caps can extend beyond
+  float finalLineAlpha = lineAlpha * float(inQuadrant && inArcBody);
+  finalLineAlpha = max(finalLineAlpha, max(capStartAlpha, capEndAlpha));
+
+  // Apply proximity fade
+  float opacity = fadeFactor * finalLineAlpha;
+
+  gl_FragColor = vec4(uLineColor, opacity);
+}
+`
+
+export function createArcMaterial(
+  fadeRadius: number = 0.225,
+  innerRadius: number = 0.02,
+  outerRadius: number = 0.025,
+  lineColor: Vector3 = new Vector3(1, 1, 1),
+  cornerGap: number = 0.03
+) {
+  return new ShaderMaterial({
+    vertexShader: arcVertexShader,
+    fragmentShader: arcFragmentShader,
+    transparent: true,
+    uniforms: {
+      uPointerPosition: { value: new Vector3(9999, 9999, 9999) },
+      uRadius: { value: fadeRadius },
+      uLineColor: { value: lineColor },
+      uInnerRadius: { value: innerRadius },
+      uOuterRadius: { value: outerRadius },
+      uCornerGap: { value: cornerGap }
+    }
+  })
+}

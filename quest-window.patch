+import { computed, Signal } from '@preact/signals'
+import { defaultApply, HandleState, HandleStore } from '@react-three/handle'
+import { PointerEvent } from '@react-three/xr'
+import { RoundedBox, useGLTF } from '@react-three/drei'
+import { useFrame, useThree } from '@react-three/fiber'
+import { Handle, HandleTarget } from '@react-three/handle'
+import { isXRInputSourceState } from '@react-three/xr'
+import { ComponentPropsWithoutRef, forwardRef, ReactNode, RefObject, useRef, useMemo, useEffect } from 'react'
+import { Euler, Group, Mesh, Object3D, PlaneGeometry, Quaternion, ShaderMaterial, Vector3 } from 'three'
+import { clamp, damp } from 'three/src/math/MathUtils.js'
+import { createArcMaterial } from '../materials/ArcMaterial'
+import { createEdgeLineMaterial } from '../materials/EdgeLineMaterial'
+import { vibrateOnEvent } from '../utils/vibrateOnEvent'
+import { HandleWithAudio } from './HandleWithAudio'
+
+// Billboard helpers
+const eulerHelper = new Euler()
+const quaternionHelper = new Quaternion()
+const vectorHelper1 = new Vector3()
+const vectorHelper2 = new Vector3()
+const zAxis = new Vector3(0, 0, 1)
+
+// Dynamic mesh that updates position every frame based on signals
+function DynamicMesh({
+  positionX,
+  positionY,
+  positionZ,
+  rotationX,
+  rotationZ,
+  scale,
+  children,
+}: {
+  positionX: Signal<number>
+  positionY: Signal<number>
+  positionZ: number
+  rotationX: number
+  rotationZ: number
+  scale: number
+  children: ReactNode
+}) {
+  const meshRef = useRef<Mesh>(null)
+
+  useFrame(() => {
+    if (meshRef.current) {
+      meshRef.current.position.set(positionX.value, positionY.value, positionZ)
+    }
+  })
+
+  return (
+    <mesh ref={meshRef} rotation-x={rotationX} rotation-z={rotationZ} scale={scale}>
+      {children}
+    </mesh>
+  )
+}
+
+// Corner resize handle with independent proximity tracking
+function CornerHandle({
+  positionX,
+  positionY,
+  rotation,
+  innerTarget,
+  onResize,
+  isOverCornerHandle,
+  moveHandlePointerRef,
+}: {
+  positionX: Signal<number>
+  positionY: Signal<number>
+  rotation: number
+  innerTarget: RefObject<Group | null>
+  onResize: (state: HandleState<unknown>) => void
+  isOverCornerHandle: RefObject<boolean>
+  moveHandlePointerRef: RefObject<Vector3>
+}) {
+  const arcMeshRef = useRef<Mesh>(null)
+  const arcMaterialRef = useRef<ShaderMaterial>(null)
+  const pointerLocalPosRef = useRef(new Vector3(9999, 9999, 9999))
+  const pointerWorldPosRef = useRef(new Vector3(0, 0, 0))
+
+  // Create arc shader material (same for all corners, rotation handles placement)
+  const arcMaterial = useMemo(() => {
+    // Arc should line up with border lines at 2.5cm from content edge
+    // Line thickness is 0.75cm (50% thicker), so center at 2.5cm means 2.125-2.875cm
+    return createArcMaterial(
+      0.225, // fadeRadius
+      0.02125,  // innerRadius (2.5cm - 0.375cm)
+      0.02875,  // outerRadius (2.5cm + 0.375cm)
+      new Vector3(1, 1, 1), // white
+      0.03 // corner gap (3cm, matching border lines)
+    )
+  }, [])
+
+  // Update pointer position for shader
+  useFrame(() => {
+    if (arcMaterialRef.current && innerTarget.current) {
+      pointerWorldPosRef.current.copy(pointerLocalPosRef.current)
+      innerTarget.current.localToWorld(pointerWorldPosRef.current)
+      arcMaterialRef.current.uniforms.uPointerPosition.value.copy(pointerWorldPosRef.current)
+    }
+  })
+
+  return (
+    <HandleWithAudio
+      targetRef={innerTarget}
+      translate="as-scale"
+      apply={onResize}
+      scale={{ z: false, uniform: true }}
+      rotate={false}
+      multitouch={false}
+    >
+      <DynamicMesh
+        positionX={positionX}
+        positionY={positionY}
+        positionZ={-0.0005}
+        rotationX={0}
+        rotationZ={rotation}
+        scale={1}
+      >
+        <mesh
+          ref={arcMeshRef}
+          onPointerEnter={(e) => {
+            isOverCornerHandle.current = true
+            // Reset move handle's pointer position to disable spotlight
+            moveHandlePointerRef.current.set(9999, 9999, 9999)
+            vibrateOnEvent(e)
+          }}
+          onPointerMove={(e) => {
+            if (e.point && innerTarget.current) {
+              pointerLocalPosRef.current.copy(e.point)
+              innerTarget.current.worldToLocal(pointerLocalPosRef.current)
+            }
+          }}
+          onPointerLeave={() => {
+            isOverCornerHandle.current = false
+            pointerLocalPosRef.current.set(9999, 9999, 9999)
+          }}
+        >
+          <planeGeometry args={[0.12, 0.12]} />
+          <primitive object={arcMaterial} ref={arcMaterialRef} attach="material" />
+        </mesh>
+      </DynamicMesh>
+    </HandleWithAudio>
+  )
+}
+
+// EdgeMoveHandle component - single edge with horizontal line shader
+function EdgeMoveHandle({
+  innerTarget,
+  fadeRadius,
+  width,
+  height,
+  pixelSize,
+  positionX,
+  positionY,
+  rotation,
+}: {
+  innerTarget: RefObject<Group>
+  fadeRadius: number
+  width: Signal<number>
+  height: Signal<number>
+  pixelSize: number
+  positionX: number
+  positionY: number
+  rotation: number
+}) {
+  const lineMeshRef = useRef<Mesh>(null)
+  const lineMaterialRef = useRef<ShaderMaterial>(null)
+  const pointerLocalPosRef = useRef(new Vector3(9999, 9999, 9999))
+  const pointerWorldPosRef = useRef(new Vector3(0, 0, 0))
+
+  // Convert positions to signals for DynamicMesh
+  const posX = useMemo(() => computed(() => positionX), [positionX])
+  const posY = useMemo(() => computed(() => positionY), [positionY])
+
+  // Calculate line dimensions based on width/height
+  const lineWidth = computed(() => (rotation === 0 || rotation === Math.PI ? width.value * pixelSize : height.value * pixelSize))
+  const lineHeight = 0.07 // 7cm quad height to contain the line and fade area
+
+  // Create edge line material
+  const lineMaterial = useMemo(
+    () =>
+      createEdgeLineMaterial(
+        fadeRadius,
+        0.005, // 0.5cm line thickness
+        new Vector3(1, 1, 1), // white line
+        { x: lineWidth.value, y: lineHeight }
+      ),
+    [fadeRadius]
+  )
+
+  // Update material quad size when width/height changes
+  useEffect(() => {
+    if (lineMaterialRef.current) {
+      lineMaterialRef.current.uniforms.uQuadSize.value = [lineWidth.value, lineHeight]
+    }
+  }, [lineWidth.value, lineHeight])
+
+  // Update pointer position in shader every frame
+  useFrame(() => {
+    if (lineMaterialRef.current && innerTarget.current) {
+      pointerWorldPosRef.current.copy(pointerLocalPosRef.current)
+      innerTarget.current.localToWorld(pointerWorldPosRef.current)
+      lineMaterialRef.current.uniforms.uPointerPosition.value.copy(pointerWorldPosRef.current)
+    }
+  })
+
+  return (
+    <HandleWithAudio
+      targetRef={innerTarget}
+      scale={false}
+      rotate={false}
+      multitouch={false}
+    >
+      <DynamicMesh
+        positionX={posX}
+        positionY={posY}
+        positionZ={-0.002}
+        rotationX={0}
+        rotationZ={rotation}
+        scale={1}
+      >
+        <mesh
+          ref={lineMeshRef}
+          onPointerEnter={(e) => {
+            vibrateOnEvent(e)
+          }}
+          onPointerMove={(e) => {
+            if (e.point && innerTarget.current) {
+              pointerLocalPosRef.current.copy(e.point)
+              innerTarget.current.worldToLocal(pointerLocalPosRef.current)
+            }
+          }}
+          onPointerLeave={() => {
+            pointerLocalPosRef.current.set(9999, 9999, 9999)
+          }}
+        >
+          <planeGeometry args={[lineWidth.value, lineHeight]} />
+          <primitive object={lineMaterial} ref={lineMaterialRef} attach="material" />
+        </mesh>
+      </DynamicMesh>
+    </HandleWithAudio>
+  )
+}
+
+/**
+ * QuestWindow - HorizonOS-style window with edge move handles and corner resize handles
+ *
+ * Features:
+ * - 4 corner resize handles with 90° arc visual indicators
+ * - 4 edge move handles with horizontal line shaders (positioned 3cm from content edge)
+ * - Proximity-based shader effects that fade when cursor moves away
+ * - Haptic feedback on handle hover
+ * - Audio feedback on handle grab/release (requires AudioEffects component in scene)
+ * - Optional billboard mode to face camera
+ * - Signal-based reactive width/height
+ *
+ * @example
+ * ```tsx
+ * import { Signal } from '@preact/signals'
+ * import { QuestWindow, AudioEffects } from 'r3f-xr-widgets'
+ *
+ * const width = useMemo(() => new Signal(1000), [])
+ * const height = useMemo(() => new Signal(600), [])
+ *
+ * <AudioEffects />
+ * <QuestWindow
+ *   width={width}
+ *   height={height}
+ *   minWidth={300}
+ *   maxWidth={2000}
+ *   minHeight={250}
+ *   maxHeight={1400}
+ *   pixelSize={0.0015}
+ *   billboard={false}
+ *   onResize={(w, h) => console.log('Resized:', w, h)}
+ * >
+ *   <Root width={width} height={height}>
+ *     {/\* Your UI content *\/}
+ *   </Root>
+ * </QuestWindow>
+ * ```
+ */
+export function QuestWindow({
+  children,
+  width,
+  height,
+  minWidth = 300,
+  maxWidth = 1000,
+  minHeight = 250,
+  maxHeight = 700,
+  pixelSize = 0.0015,
+  billboard = false,
+  fadeRadius = 0.225,
+  onResize,
+}: {
+  /** Content to render inside the window */
+  children?: ReactNode
+  /** Width signal (in pixels) */
+  width: Signal<number>
+  /** Height signal (in pixels) */
+  height: Signal<number>
+  /** Minimum width in pixels (default: 300) */
+  minWidth?: number
+  /** Maximum width in pixels (default: 1000) */
+  maxWidth?: number
+  /** Minimum height in pixels (default: 250) */
+  minHeight?: number
+  /** Maximum height in pixels (default: 700) */
+  maxHeight?: number
+  /** Pixel size in world units (default: 0.0015 = 1.5mm per pixel) */
+  pixelSize?: number
+  /** Enable billboard mode to face camera (default: false) */
+  billboard?: boolean
+  /** Proximity fade radius in meters (default: 0.225) */
+  fadeRadius?: number
+  /** Callback when window is resized */
+  onResize?: (width: number, height: number) => void
+}) {
+  const innerTarget = useRef<Group>(null)
+  const initialHeight = useRef<number | undefined>(undefined)
+  const initialWidth = useRef<number | undefined>(undefined)
+  const isOverCornerHandle = useRef<boolean>(false)
+
+  // Proximity mesh for hover feedback
+  const proximityMeshRef = useRef<Mesh>(null)
+  const lastPointerLocalPosRef = useRef(new Vector3(9999, 9999, 9999))
+
+  const { camera } = useThree()
+
+  // Compute handle positions based on current width/height
+  const halfWidth = computed(() => (width.value * pixelSize) / 2)
+  const halfHeight = computed(() => (height.value * pixelSize) / 2)
+
+  // Compute corner positions for resize handles
+  const topRightX = computed(() => (width.value * pixelSize) / 2)
+  const topRightY = computed(() => (height.value * pixelSize) / 2)
+  const topLeftX = computed(() => -(width.value * pixelSize) / 2)
+  const topLeftY = computed(() => (height.value * pixelSize) / 2)
+  const bottomLeftX = computed(() => -(width.value * pixelSize) / 2)
+  const bottomLeftY = computed(() => -(height.value * pixelSize) / 2)
+  const bottomRightX = computed(() => (width.value * pixelSize) / 2)
+  const bottomRightY = computed(() => -(height.value * pixelSize) / 2)
+
+  // Shared resize callback for all corner handles
+  const handleResize = (state: HandleState<unknown>, target: Object3D) => {
+    if (state.first) {
+      initialHeight.current = height.value
+      initialWidth.current = width.value
+    } else if (initialHeight.current != null && initialWidth.current != null) {
+      const newHeight = clamp(state.current.scale.y * initialHeight.current, minHeight, maxHeight)
+      const newWidth = clamp(state.current.scale.x * initialWidth.current, minWidth, maxWidth)
+      height.value = newHeight
+      width.value = newWidth
+      onResize?.(newWidth, newHeight)
+    }
+  }
+
+  // Billboard effect - make window face camera
+  useFrame((state, dt) => {
+    if (billboard && innerTarget.current != null) {
+      state.camera.getWorldPosition(vectorHelper1)
+      innerTarget.current.getWorldPosition(vectorHelper2)
+      quaternionHelper.setFromUnitVectors(zAxis, vectorHelper1.sub(vectorHelper2).normalize())
+      eulerHelper.setFromQuaternion(quaternionHelper, 'YXZ')
+      innerTarget.current.rotation.y = damp(innerTarget.current.rotation.y, eulerHelper.y, 10, dt)
+    }
+
+    // Update proximity mesh geometry to maintain fadeRadius buffer around content
+    if (proximityMeshRef.current) {
+      const contentWidth = width.value * pixelSize
+      const contentHeight = height.value * pixelSize
+      const proximityWidth = contentWidth + 2 * fadeRadius
+      const proximityHeight = contentHeight + 2 * fadeRadius
+
+      // Update geometry if size changed
+      const geometry = proximityMeshRef.current.geometry as any
+      if (geometry.parameters) {
+        const currentWidth = geometry.parameters.width
+        const currentHeight = geometry.parameters.height
+        if (Math.abs(currentWidth - proximityWidth) > 0.001 || Math.abs(currentHeight - proximityHeight) > 0.001) {
+          proximityMeshRef.current.geometry.dispose()
+          proximityMeshRef.current.geometry = new PlaneGeometry(proximityWidth, proximityHeight)
+        }
+      }
+    }
+  })
+
+  return (
+    <HandleTarget>
+      <group>
+        <group ref={innerTarget}>
+          {/* Proximity detection mesh - invisible, sized to fadeRadius around content */}
+          {/* Handles pointer tracking in gap area between content and boundary */}
+          <mesh
+            ref={proximityMeshRef}
+            position-z={-0.003}
+            onPointerMove={(e) => {
+              if (!isOverCornerHandle.current && e.point && innerTarget.current) {
+                lastPointerLocalPosRef.current.copy(e.point)
+                innerTarget.current.worldToLocal(lastPointerLocalPosRef.current)
+              }
+            }}
+            onPointerEnter={(e) => {
+              vibrateOnEvent(e)
+            }}
+            onPointerLeave={() => {
+              if (!isOverCornerHandle.current) {
+                lastPointerLocalPosRef.current.set(9999, 9999, 9999)
+              }
+            }}
+          >
+            <planeGeometry args={[(width.value * pixelSize) + 2 * fadeRadius, (height.value * pixelSize) + 2 * fadeRadius]} />
+            <meshBasicMaterial transparent opacity={0} />
+          </mesh>
+
+          {/* Common parent - receives bubbled pointer events from all children */}
+          <group
+            onPointerMove={(e) => {
+              // pointermove bubbles from children (content, handles)
+              // Don't update if pointer is over a corner handle
+              if (!isOverCornerHandle.current && e.point && innerTarget.current) {
+                lastPointerLocalPosRef.current.copy(e.point)
+                innerTarget.current.worldToLocal(lastPointerLocalPosRef.current)
+              }
+            }}
+          >
+            {/* Content */}
+            {children}
+
+            {/* Corner resize handles - 4 corners with 90° arcs */}
+            <CornerHandle
+              positionX={topRightX}
+              positionY={topRightY}
+              rotation={0}
+              innerTarget={innerTarget}
+              onResize={handleResize}
+              isOverCornerHandle={isOverCornerHandle}
+              moveHandlePointerRef={lastPointerLocalPosRef}
+            />
+            <CornerHandle
+              positionX={topLeftX}
+              positionY={topLeftY}
+              rotation={Math.PI / 2}
+              innerTarget={innerTarget}
+              onResize={handleResize}
+              isOverCornerHandle={isOverCornerHandle}
+              moveHandlePointerRef={lastPointerLocalPosRef}
+            />
+            <CornerHandle
+              positionX={bottomLeftX}
+              positionY={bottomLeftY}
+              rotation={Math.PI}
+              innerTarget={innerTarget}
+              onResize={handleResize}
+              isOverCornerHandle={isOverCornerHandle}
+              moveHandlePointerRef={lastPointerLocalPosRef}
+            />
+            <CornerHandle
+              positionX={bottomRightX}
+              positionY={bottomRightY}
+              rotation={-Math.PI / 2}
+              innerTarget={innerTarget}
+              onResize={handleResize}
+              isOverCornerHandle={isOverCornerHandle}
+              moveHandlePointerRef={lastPointerLocalPosRef}
+            />
+
+            {/* Edge move handles - 4 edges with horizontal line shaders, 3cm from content edge */}
+            {/* Top edge */}
+            <EdgeMoveHandle
+              innerTarget={innerTarget}
+              fadeRadius={fadeRadius}
+              width={width}
+              height={height}
+              pixelSize={pixelSize}
+              positionX={0}
+              positionY={halfHeight.value + 0.03}
+              rotation={0}
+            />
+            {/* Bottom edge */}
+            <EdgeMoveHandle
+              innerTarget={innerTarget}
+              fadeRadius={fadeRadius}
+              width={width}
+              height={height}
+              pixelSize={pixelSize}
+              positionX={0}
+              positionY={-halfHeight.value - 0.03}
+              rotation={0}
+            />
+            {/* Left edge */}
+            <EdgeMoveHandle
+              innerTarget={innerTarget}
+              fadeRadius={fadeRadius}
+              width={width}
+              height={height}
+              pixelSize={pixelSize}
+              positionX={-halfWidth.value - 0.03}
+              positionY={0}
+              rotation={Math.PI / 2}
+            />
+            {/* Right edge */}
+            <EdgeMoveHandle
+              innerTarget={innerTarget}
+              fadeRadius={fadeRadius}
+              width={width}
+              height={height}
+              pixelSize={pixelSize}
+              positionX={halfWidth.value + 0.03}
+              positionY={0}
+              rotation={Math.PI / 2}
+            />
+          </group>
+          {/* End of common parent */}
+        </group>
+      </group>
+    </HandleTarget>
+  )
+}

@@ -0,0 +1,78 @@
+import { ShaderMaterial, Vector3 } from 'three'
+
+// Single horizontal line shader - vertex shader
+export const edgeLineVertexShader = /* glsl */ `
+varying vec3 vWorldPosition;
+varying vec2 vUv;
+
+void main() {
+  vUv = uv;
+  vec4 worldPosition = modelMatrix * vec4(position, 1.0);
+  vWorldPosition = worldPosition.xyz;
+  gl_Position = projectionMatrix * viewMatrix * worldPosition;
+}
+`
+
+// Single horizontal line shader - fragment shader
+export const edgeLineFragmentShader = /* glsl */ `
+uniform vec3 uPointerPosition;
+uniform float uRadius;
+uniform vec3 uLineColor;
+uniform float uLineThickness;
+uniform vec2 uQuadSize; // actual quad dimensions in world units
+
+varying vec3 vWorldPosition;
+varying vec2 vUv;
+
+void main() {
+  // Calculate proximity fade with steeper falloff
+  float dist = distance(vWorldPosition, uPointerPosition);
+  float fadeFactor = smoothstep(uRadius, 0.0, dist);
+  fadeFactor = fadeFactor * fadeFactor; // Square for steeper falloff
+
+  // Convert current position to world space (centered at origin)
+  vec2 worldPos = (vUv - 0.5) * uQuadSize;
+
+  // Single horizontal line down the center (Y = 0)
+  float lineAlpha = smoothstep(uLineThickness + 0.005, uLineThickness - 0.005, abs(worldPos.y));
+
+  // Rounded caps at line endpoints (left and right edges)
+  float lineHalfWidth = uLineThickness;
+  float leftCapX = -uQuadSize.x * 0.5;
+  float rightCapX = uQuadSize.x * 0.5;
+
+  vec2 leftCap = vec2(leftCapX, 0.0);
+  vec2 rightCap = vec2(rightCapX, 0.0);
+
+  float capAlpha = 0.0;
+  capAlpha = max(capAlpha, smoothstep(lineHalfWidth + 0.005, lineHalfWidth - 0.005, length(worldPos - leftCap)));
+  capAlpha = max(capAlpha, smoothstep(lineHalfWidth + 0.005, lineHalfWidth - 0.005, length(worldPos - rightCap)));
+
+  float isLine = max(lineAlpha, capAlpha);
+
+  // Apply proximity fade to opacity
+  float opacity = fadeFactor * isLine;
+
+  gl_FragColor = vec4(uLineColor, opacity);
+}
+`
+
+export function createEdgeLineMaterial(
+  fadeRadius: number,
+  lineThickness: number = 0.005, // 0.5cm default
+  lineColor: Vector3 = new Vector3(1, 1, 1),
+  quadSize: { x: number; y: number } = { x: 1, y: 1 }
+) {
+  return new ShaderMaterial({
+    vertexShader: edgeLineVertexShader,
+    fragmentShader: edgeLineFragmentShader,
+    transparent: true,
+    uniforms: {
+      uPointerPosition: { value: new Vector3(0, 0, 0) },
+      uRadius: { value: fadeRadius },
+      uLineColor: { value: lineColor },
+      uLineThickness: { value: lineThickness },
+      uQuadSize: { value: [quadSize.x, quadSize.y] }
+    }
+  })
+}
